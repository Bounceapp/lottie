{
  "extends": "expo/tsconfig.base",
  "include": ["**/*", ".storybook/**/*"],
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["jest"],
    "paths": {
      "@bounceapp/lottie": ["./src/index"]
    }
  }
}
